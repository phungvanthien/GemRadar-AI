# Choose your AI provider: "fridayaix" (Anthropic-compatible) or "openai".
# If left blank, it auto-detects from whichever key you set below (FridayAIX first).
AI_PROVIDER=fridayaix

# --- Option A: FridayAIX (Anthropic-compatible AI gateway) ---
ANTHROPIC_BASE_URL=https://oneai.fridayaix.com/
ANTHROPIC_AUTH_TOKEN=sk-your-fridayaix-token
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6

# --- Option B: OpenAI ---
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# CoinGecko — https://www.coingecko.com/en/api
# The free/public tier needs no key. A Demo or Pro key (optional) raises rate limits.
# COINGECKO_API_KEY=your-coingecko-demo-api-key

# Flux RPC (Solana on-chain data) — https://fluxrpc.com
# Base URL WITHOUT the ?key= suffix; the key is sent separately.
FLUX_RPC_URL=https://eu.fluxrpc.com
FLUX_RPC_API_KEY=your-flux-rpc-api-key

# RugCheck — third-party Solana token risk scoring. https://api.rugcheck.xyz
# Optional: if unset, the pipeline skips RugCheck enrichment (no failure).
RUGCHECK_API_KEY=your-rugcheck-api-key

# Jupiter Price API — used for live Solana price + liquidity.
# Free, no key required (endpoint: https://lite-api.jup.ag/price/v3). Nothing to set.

# --- Automated trade execution (src/lib/trade-*.ts) ---
# SAFETY: the system defaults to DRY-RUN. In dry-run it logs "would buy/sell"
# decisions and NEVER signs a real transaction. Real funds move ONLY when ALL of
# these align: TRADE_MODE=live AND autoBuyEnabled=true in the settings panel AND a
# valid TRADE_WALLET_SECRET_KEY is loaded AND TRADE_KILL_SWITCH=false.
#
# LIVE is fully implemented: it builds/signs/sends the Jupiter swap, confirms
# against the transaction's own blockhash, retries transient sends, and — on an
# ambiguous result (confirm timeout) — reconciles the real on-chain token balance
# before ever selling again, so a timeout cannot cause a double-sell.
#
# To go live (only after dry-run looks right):
#   1) fund the dedicated hot wallet with a small amount you can afford to lose
#   2) set autoBuyEnabled=true in the settings panel
#   3) set TRADE_MODE=live here and restart the worker
# Flip TRADE_KILL_SWITCH=true at any time to halt entries and liquidate down to
# the manual-hold moon bag on the next tick.
#
# Leave TRADE_MODE=dry-run until you have verified behaviour. This .env file is
# gitignored (.env*), but NEVER paste the secret key anywhere it could be committed
# or sent to a browser.
TRADE_MODE=dry-run

# Solana RPC endpoint for balance checks + sending transactions. The public
# endpoint works for testing; use a paid RPC (Helius/Triton/QuickNode) for live.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Dedicated HOT WALLET private key for the bot. Use a BRAND-NEW wallet, NOT your
# main wallet, and fund it with ONLY the SOL you can afford to lose entirely.
# Accepts base58 (Phantom export) or a JSON byte array ([12,34,...]). Server-only.
# NEVER COMMIT. NEVER send to the client.
TRADE_WALLET_SECRET_KEY=

# Hard limits (enforced before any quote). Blast-radius caps.
TRADE_MAX_SOL_PER_TRADE=0.25   # reject any single buy larger than this
TRADE_MAX_TRADES_PER_DAY=10    # per-day entry cap
TRADE_MIN_WALLET_SOL=0.05      # keep at least this much SOL (fees); refuse buys below it
TRADE_SLIPPAGE_BPS=100         # swap slippage tolerance, basis points (100 = 1%)
TRADE_MAX_PRICE_IMPACT_PCT=3   # reject a swap quote whose price impact exceeds this %
TRADE_MAX_POOL_SHARE=0.02      # a buy must be <= this fraction of pool liquidity (thin-pool guard)

# Emergency stop. true => no new entries AND the exit monitor liquidates open
# positions (down to the manual-hold moon bag) on its next tick.
TRADE_KILL_SWITCH=false

# --- Telegram social worker (scripts/tg-worker, Phase 4) — OPTIONAL ---
# Powers the Social gem-score category by joining project Telegram channels
# read-only. Uses a REAL user account via MTProto — Telegram can ban accounts
# that auto-join/leave in bulk. USE A SECONDARY PHONE NUMBER. See
# scripts/tg-worker/README.md before enabling. Leave unset to skip Social scoring.
# Get api_id / api_hash at https://my.telegram.org (API development tools).
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=your-32-char-hex-hash
# TELEGRAM_PHONE=+840000000000
# TELEGRAM_SESSION=scripts/tg-worker/alphahunter.session
# TELEGRAM_2FA_PASSWORD=only-if-your-account-has-2fa

# --- X (Twitter) social monitoring — via Nitter (FREE) or official API ---
# The Python worker (scripts/tg-worker/worker.py) now handles BOTH Telegram AND
# X in a single pass. X buzz is fetched via public Nitter RSS by default —
# no account, no API key, no Playwright needed. Set x.source="nitter" in
# social-monitor.config.json (already the default).
#
# Optional: override the Nitter instance list in social-monitor.config.json
# if all default instances go down (https://status.d420.de for a live list).
#
# Optional paid path: if you have an X API v2 bearer token, set
#   x.source = "official"   in social-monitor.config.json
# and add the token below — the Next.js route (src/app/api/solana-gems/route.ts)
# uses it directly for official-handle lookups; the Python worker ignores it.
# X_BEARER_TOKEN=your-x-api-v2-bearer-token
