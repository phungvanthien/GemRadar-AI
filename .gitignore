# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Telegram social worker (scripts/tg-worker)
# Session files hold login credentials — never commit them. Data files are
# runtime state shared with the Next.js side.
*.session
*.session-journal
scripts/tg-worker/.venv/
scripts/tg-worker/watchlist.json
scripts/social-scores.json
__pycache__/
*.pyc

# X buzz worker (scripts/x-worker)
# cookies.json holds a logged-in X session — treat like a credential, never
# commit it. x-scores.json is runtime state shared with the Next.js side.
scripts/x-worker/cookies.json
scripts/x-worker/node_modules/
scripts/x-scores.json

# Automated trade execution — runtime state. positions holds live P&L and token
# amounts; settings may hold trade config. Never commit either.
alphahunter-positions.json
alphahunter-settings.json
# Capital mandate — entrusted-funds config + state. Runtime state, never commit.
alphahunter-mandate.json
alphahunter-mandate-audit.log
# Outcome memory — AI gem-score predictions + realized outcomes. Runtime state.
alphahunter-gem-outcomes.json
# trade-worker temp compile dirs (created inside node_modules at runtime)
node_modules/.trade-*
